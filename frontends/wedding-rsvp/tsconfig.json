{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "es5",
    "rootDir": "./",
    "module": "esnext",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "lib": [
      "dom",
      "es2015.promise",
      "es2017",
      "esnext.asynciterable"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "moduleResolution": "node",
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "*": [
        "libs/*",
      ],
      "#test/*": [
        "test/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "exclude": [
    "./**/*.spec.ts"
  ],
  "include": [
    "./src",
  ]
}
