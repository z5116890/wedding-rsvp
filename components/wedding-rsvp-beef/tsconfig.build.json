{
  "compilerOptions": {
    "declaration": true,
    "module": "commonjs",
    "target": "es2020",
    "outDir": "./dist",
    "rootDir": "./",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "moduleResolution": "node",
    "sourceMap": true,
    "strict": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": "./",
    "lib": [
      "es2020"
    ],
    "paths": {
      "*": [
        "libs/*",
      ],
      "#test/*": [
        "test/*"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": [
    "./src/app",
    "./test",
    "./libs"
  ],
  "compileOnSave": false
}
